meta {
  name: Upload Invalid File
  type: http
  seq: 2
}

post {
  url: {{host}}/api/v1/documents
}

body:multipart-form {
  file: @not-a-pdf.txt
  title: Should Fail
}

tests {
  test("should return 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("should return INVALID_FILE_TYPE error", function() {
    expect(res.body.error).to.equal("INVALID_FILE_TYPE");
  });

  test("should have error message", function() {
    expect(res.body.message).to.be.a("string");
    expect(res.body.message.length).to.be.above(0);
  });
}
