meta {
  name: Get Document - Not Found
  type: http
  seq: 5
}

get {
  url: {{host}}/api/v1/documents/00000000-0000-0000-0000-000000000000
}

tests {
  test("should return 404", function() {
    expect(res.status).to.equal(404);
  });

  test("should return DOCUMENT_NOT_FOUND error", function() {
    expect(res.body.error).to.equal("DOCUMENT_NOT_FOUND");
  });

  test("should have error message and timestamp", function() {
    expect(res.body).to.have.property("message");
    expect(res.body).to.have.property("timestamp");
  });
}
