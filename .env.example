# Classroom Clarity RAG — Local AI Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These are only needed when running with the "local-ai" profile
# (real Vertex AI instead of mock models).

# Path to your GCP service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json

# Your GCP project ID (find it at https://console.cloud.google.com)
GCP_PROJECT_ID=your-gcp-project-id

# GCP region for Vertex AI (default: us-central1)
GCP_LOCATION=us-central1
